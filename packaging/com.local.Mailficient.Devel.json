{
  "app-id": "com.local.Mailficient",
  "runtime": "org.gnome.Platform",
  "runtime-version": "49",
  "sdk": "org.gnome.Sdk",
  "command": "mailficient",
  "build-options": {
    "no-debuginfo": true
  },
  "finish-args": [
    "--share=ipc",
    "--socket=x11",
    "--socket=wayland",
    "--share=network",
    "--talk-name=org.freedesktop.secrets",
    "--talk-name=org.freedesktop.Notifications",
    "--own-name=com.local.Mailficient.BackgroundWorker",
    "--talk-name=org.gnome.OnlineAccounts",
    "--talk-name=org.gnome.evolution.dataserver.Sources5",
    "--talk-name=org.gnome.evolution.dataserver.AddressBook10",
    "--talk-name=org.gnome.evolution.dataserver.Calendar8"
  ],
  "modules": [
    {
      "name": "libical",
      "buildsystem": "simple",
      "build-commands": [
        "cmake -S . -B _flatpak_build -G Ninja -DCMAKE_INSTALL_PREFIX=/app -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_BUILD_TYPE=Release -DICAL_BUILD_DOCS=OFF -DICAL_BUILD_EXAMPLES=OFF -DICAL_GLIB=ON -DICAL_GLIB_VAPI=ON -DGOBJECT_INTROSPECTION=ON",
        "cmake --build _flatpak_build --parallel $FLATPAK_BUILDER_N_JOBS",
        "cmake --install _flatpak_build"
      ],
      "sources": [{
        "type": "git",
        "url": "https://github.com/libical/libical.git",
        "tag": "v3.0.20",
        "commit": "57ce34025066935f356fd539e6deb7a7a9952618"
      }]
    },
    {
      "name": "evolution-data-server",
      "buildsystem": "simple",
      "build-commands": [
        "cmake -S . -B _flatpak_build -G Ninja -DCMAKE_INSTALL_PREFIX=/app -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_BUILD_TYPE=Release -DENABLE_TESTS=OFF -DENABLE_EXAMPLES=OFF -DENABLE_GTK=OFF -DENABLE_GTK4=OFF -DENABLE_OAUTH2_WEBKITGTK=OFF -DENABLE_OAUTH2_WEBKITGTK4=OFF -DENABLE_GOA=OFF -DENABLE_WEATHER=OFF -DENABLE_CANBERRA=OFF -DWITH_OPENLDAP=OFF -DWITH_LIBDB=OFF -DENABLE_INTROSPECTION=ON -DENABLE_VALA_BINDINGS=ON -DWITH_SYSTEMDUSERUNITDIR=no",
        "cmake --build _flatpak_build --parallel $FLATPAK_BUILDER_N_JOBS",
        "cmake --install _flatpak_build"
      ],
      "sources": [{
        "type": "archive",
        "url": "https://download.gnome.org/sources/evolution-data-server/3.60/evolution-data-server-3.60.2.tar.xz",
        "sha256": "2084dbdac396371b365d504c1ff45866ba8dca2f1252e5da1d3d9c33abdc1286"
      }]
    },
    {
      "name": "mailficient",
      "buildsystem": "meson",
      "run-tests": true,
      "config-opts": ["-Dcamel=enabled", "-Daddressbook=enabled", "-Dcalendar=enabled"],
      "sources": [{ "type": "dir", "path": ".." }]
    }
  ]
}
