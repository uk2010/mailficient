{
  "app-id": "com.local.Mailficient",
  "runtime": "org.gnome.Platform",
  "runtime-version": "50",
  "sdk": "org.gnome.Sdk",
  "command": "mailficient",
  "build-options": {
    "no-debuginfo": true
  },
  "finish-args": [
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--share=network",
    "--talk-name=org.freedesktop.secrets",
    "--talk-name=org.freedesktop.Notifications",
    "--own-name=com.local.Mailficient.BackgroundWorker",
    "--talk-name=org.gnome.OnlineAccounts",
    "--talk-name=org.gnome.evolution.dataserver.Sources5",
    "--talk-name=org.gnome.evolution.dataserver.AddressBook10",
    "--talk-name=org.gnome.evolution.dataserver.Calendar8"
  ],
  "modules": [
    {
      "name": "libical",
      "buildsystem": "simple",
      "build-commands": [
        "cmake -S . -B _flatpak_build -G Ninja -DCMAKE_INSTALL_PREFIX=/app -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_BUILD_TYPE=Release -DICAL_BUILD_DOCS=OFF -DICAL_BUILD_EXAMPLES=OFF -DICAL_GLIB=ON -DICAL_GLIB_VAPI=ON -DGOBJECT_INTROSPECTION=ON",
        "cmake --build _flatpak_build --parallel $FLATPAK_BUILDER_N_JOBS",
        "cmake --install _flatpak_build"
      ],
      "sources": [{
        "type": "git",
        "url": "https://github.com/libical/libical.git",
        "tag": "v3.0.20",
        "commit": "57ce34025066935f356fd539e6deb7a7a9952618"
      }, {
        "type": "patch",
        "path": "patches/libical-3.0.20-merge-overflow.patch"
      }]
    },
    {
      "name": "geocode-glib",
      "buildsystem": "meson",
      "config-opts": [
        "--libdir=lib",
        "-Denable-gtk-doc=false",
        "-Denable-introspection=false",
        "-Denable-installed-tests=false",
        "-Dsoup2=false"
      ],
      "sources": [{
        "type": "archive",
        "url": "https://download.gnome.org/sources/geocode-glib/3.26/geocode-glib-3.26.4.tar.xz",
        "sha256": "2d9a6826d158470449a173871221596da0f83ebdcff98b90c7049089056a37aa"
      }]
    },
    {
      "name": "libgweather",
      "buildsystem": "meson",
      "config-opts": [
        "--libdir=lib",
        "-Denable_vala=false",
        "-Dgtk_doc=false",
        "-Dintrospection=false",
        "-Dtests=false"
      ],
      "sources": [{
        "type": "archive",
        "url": "https://download.gnome.org/sources/libgweather/4.4/libgweather-4.4.4.tar.xz",
        "sha256": "7017677753cdf7d1fdc355e4bfcdb1eba8369793a8df24d241427a939cbf4283"
      }]
    },
    {
      "name": "evolution-data-server",
      "buildsystem": "simple",
      "build-commands": [
        "cmake -S . -B _flatpak_build -G Ninja -DCMAKE_INSTALL_PREFIX=/app -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_BUILD_TYPE=Release -DENABLE_TESTS=OFF -DENABLE_EXAMPLES=OFF -DENABLE_GTK=OFF -DENABLE_GTK4=ON -DENABLE_OAUTH2_WEBKITGTK=OFF -DENABLE_OAUTH2_WEBKITGTK4=OFF -DENABLE_GOA=OFF -DENABLE_WEATHER=OFF -DENABLE_CANBERRA=OFF -DWITH_OPENLDAP=OFF -DWITH_LIBDB=OFF -DENABLE_INTROSPECTION=ON -DENABLE_VALA_BINDINGS=ON -DWITH_SYSTEMDUSERUNITDIR=no",
        "cmake --build _flatpak_build --parallel $FLATPAK_BUILDER_N_JOBS",
        "cmake --install _flatpak_build"
      ],
      "sources": [{
        "type": "archive",
        "url": "https://download.gnome.org/sources/evolution-data-server/3.60/evolution-data-server-3.60.2.tar.xz",
        "sha256": "2084dbdac396371b365d504c1ff45866ba8dca2f1252e5da1d3d9c33abdc1286"
      }]
    },
    {
      "name": "gnome-calendar-library",
      "buildsystem": "meson",
      "config-opts": [
        "--libdir=lib",
        "-Dembedded-library=true",
        "-Dbuild-tests=false"
      ],
      "sources": [{ "type": "dir", "path": "../third_party/gnome-calendar" }]
    },
    {
      "name": "unifdef",
      "buildsystem": "simple",
      "build-commands": [
        "make CFLAGS=-std=gnu17 -j$FLATPAK_BUILDER_N_JOBS",
        "make prefix=/app install"
      ],
      "sources": [{
        "type": "archive",
        "url": "https://dotat.at/prog/unifdef/unifdef-2.12.tar.xz",
        "sha256": "43ce0f02ecdcdc723b2475575563ddb192e988c886d368260bc0a63aee3ac400"
      }]
    },
    {
      "name": "webkitgtk",
      "buildsystem": "cmake-ninja",
      "config-opts": [
        "-DPORT=GTK",
        "-DCMAKE_BUILD_TYPE=Release",
        "-DUSE_GTK4=ON",
        "-DENABLE_DOCUMENTATION=OFF",
        "-DENABLE_INTROSPECTION=OFF",
        "-DENABLE_MINIBROWSER=OFF",
        "-DENABLE_WEBDRIVER=OFF",
        "-DENABLE_GAMEPAD=OFF",
        "-DENABLE_SPEECH_SYNTHESIS=OFF",
        "-DENABLE_SPELLCHECK=OFF",
        "-DENABLE_JOURNALD_LOG=OFF",
        "-DENABLE_QUARTZ_TARGET=OFF",
        "-DENABLE_ENCRYPTED_MEDIA=OFF",
        "-DENABLE_MEDIA_RECORDER=OFF",
        "-DENABLE_MEDIA_STREAM=OFF",
        "-DENABLE_WEB_RTC=OFF",
        "-DENABLE_GPU_PROCESS=OFF",
        "-DUSE_FLITE=OFF",
        "-DUSE_GBM=OFF",
        "-DUSE_LIBDRM=OFF",
        "-DUSE_LIBBACKTRACE=OFF",
        "-DUSE_LIBSECRET=OFF",
        "-DUSE_AVIF=OFF",
        "-DUSE_JPEGXL=OFF"
      ],
      "sources": [{
        "type": "archive",
        "url": "https://webkitgtk.org/releases/webkitgtk-2.52.6.tar.xz",
        "sha256": "179a2ea3f8f6edd4be7f31fdc55afc57bd0729f1fba648c61d4181539ac116fc"
      }]
    },
    {
      "name": "mailficient",
      "buildsystem": "meson",
      "run-tests": true,
      "config-opts": [
        "-Dcamel=enabled",
        "-Daddressbook=enabled",
        "-Dcalendar=enabled",
        "-Dgcal-archive=/app/lib/mailficient/libgcal-private.a",
        "-Dgcal-libdir=/app/lib"
      ],
      "sources": [{ "type": "dir", "path": ".." }]
    }
  ]
}
